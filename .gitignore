node_modules/
dist/
dist-ts/
*.tsbuildinfo
.env
.env.local

# Windows alternate-data-stream metadata (from files edited on the Windows side)
*:Zone.Identifier

# Base44 design export — visual reference only, lifted by hand; never committed
design-ref/

# Advisor drop folder (docs/COMMS/from-advisor/README.md) — the Advisor's own scratch/staging
# area, written directly to disk. Convenience + visibility only; anything durable gets promoted
# by the PM into a tracked file (ADVISOR_TO_PM.md, a docs/ file) and committed from there.
docs/COMMS/from-advisor/

# Owner's private local folder (secrets/notes, e.g. ORIGIN_SECRET.txt) — never commit it. Also
# keeps it out of `gcloud run deploy --source .` uploads: with no .gcloudignore, gcloud's default
# ignore list includes .gitignore, so this line is what stops it reaching Cloud Build.
private/
